{
  "name": "kaia-api",
  "version": "1.0.0",
  "description": "kaia api",
  "main": "main.js",
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "typeorm": "tsx ./node_modules/typeorm/cli.js",
    "migrations:create": "npm run typeorm -- migration:create",
    "migrations:generate": "npm run typeorm -- migration:generate -d src/models/dataSource.ts",
    "migrations:run": "npm run typeorm -- migration:run -d src/models/dataSource.ts",
    "migrations:revert": "npm run typeorm -- migration:revert -d src/models/dataSource.ts"
  },
  "keywords": [],
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/postgres": "^6.1.2",
    "@fastify/sensible": "^6.0.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "typeorm": "^1.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
